# Secrets — never commit. Contains Twilio, Groq, Gemini and ngrok credentials.
.env
.env.*
!.env.example

# Local environments and caches
.venv/
.tmp/
.cache/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
dist/

# Runtime data living on the D: volumes
docker/postgres-data/
docker/redis-data/
docker/backend-logs/
docker/media/

# Vendored binaries (ffmpeg is ~200MB, well over GitHub's file limit)
tools/

# Recorded demo output; regenerate with scripts/record_demo.py
demo/*.webm
demo/*.mp4
demo/raw
demo/

# Updater signing key. Losing it means no client can ever receive an update
# again — they would all need a fresh manual install. Committing it means
# anyone can push code to every client machine.
.secrets/
*.key

# Built installers. Three megabytes per release, and git keeps every one of
# them forever — the releases live on the update server, which is where
# clients actually fetch them from. latest.json stays tracked: it is small,
# and it is the record of what is currently being offered.
builds/desktop/*.exe
builds/desktop/*.msi
builds/desktop/*.sig

# Personal Claude Code settings, including the production-deploy grant.
# Machine-local on purpose: it should not travel with the repository.
.claude/settings.local.json

# Built locally so screenshots can be taken against a real backend without
# overwriting frontend/dist, which is the artifact production is verified
# against. Regenerated by a vite build; never part of a release.
docker/guide-web/
docker/updates/

# Theme sweeps of the dashboard, taken for a one-off design review. The guide's
# own images live in docs/images/guide and are committed; these are regenerated
# by scripts/make_guide_screenshots.py with GUIDE_THEME set.
docs/images/guide-dark/
docs/images/guide-light/
