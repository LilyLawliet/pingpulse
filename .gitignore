# Secrets — never commit. Contains Twilio, Groq, Gemini and ngrok credentials.
.env
.env.*
!.env.example

# Local environments and caches
.venv/
.tmp/
.cache/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
dist/

# Runtime data living on the D: volumes
docker/postgres-data/
docker/redis-data/
docker/backend-logs/
docker/media/

# Vendored binaries (ffmpeg is ~200MB, well over GitHub's file limit)
tools/

# Recorded demo output; regenerate with scripts/record_demo.py
demo/*.webm
demo/*.mp4
demo/raw
demo/

# Updater signing key. Losing it means no client can ever receive an update
# again — they would all need a fresh manual install. Committing it means
# anyone can push code to every client machine.
.secrets/
*.key
