# PingPulse frontend — Vite build served by Nginx with a /ws WebSocket proxy
FROM node:20-alpine AS build

WORKDIR /build

COPY frontend/package.json ./package.json
RUN npm install

COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine

RUN rm -f /etc/nginx/conf.d/default.conf
COPY docker/nginx.conf /etc/nginx/conf.d/pingpulse.conf
COPY --from=build /build/dist /usr/share/nginx/html

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=10s --start-period=15s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1:3000/nginx-health || exit 1

CMD ["nginx", "-g", "daemon off;"]
