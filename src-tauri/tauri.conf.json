{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PingPulse",
  "version": "1.2.1",
  "identifier": "com.pingpulse.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PingPulse Telemetry & Sales Dashboard",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "PingPulse",
    "copyright": "\u00a9 2026 PingPulse",
    "category": "Business",
    "shortDescription": "WhatsApp AI sales agent dashboard",
    "longDescription": "PingPulse \u2014 live telemetry, CRM pipeline and conversation monitoring for the PingPulse WhatsApp AI sales agent.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "timestampUrl": null
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCQ0YxQzUzRThBOTdFNkQKUldSdGZxbm9VeHpQMndMSDVkYmpFaUdTZ1o3NlAyZXdnZkhxU1JBWDJSQXh4OG5UMzJNQXNiNGEK",
      "endpoints": [
        "https://github.com/LilyLawliet/pingpulse/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
